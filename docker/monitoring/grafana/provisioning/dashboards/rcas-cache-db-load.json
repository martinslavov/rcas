        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=~\"$job\",application=~\"$application\",instance=~\"$instance\",uri!~\"/actuator.*|UNKNOWN\"}[$__rate_interval]))",
