          "editorMode": "code",
          "expr": "rcas_pg_longest_tx_seconds{job=\"$job\"}",
          "legendFormat": "longest transaction",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "max by (table, phase) (rcas_pg_vacuum_in_progress_seconds{job=\"$job\"})",
          "legendFormat": "vacuum {{table}} ({{phase}})",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Long Transactions and In-Progress Vacuum",
      "type": "timeseries"
